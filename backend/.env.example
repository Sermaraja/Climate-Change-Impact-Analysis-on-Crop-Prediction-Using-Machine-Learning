# FastAPI Backend Environment Variables
PROJECT_NAME="Climate Change Impact Analysis on Crop Prediction Using Machine Learning"
VERSION="1.0.0"
API_V1_STR="/api"

# Security (Set in Render Environment Variables)
SECRET_KEY="your-production-secret-key-min-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Production Database (Render PostgreSQL + PostGIS)
# Set in Render Environment Variables as DATABASE_URL
DATABASE_URL="postgresql://user:password@host.render.com/dbname"

# Production Frontend Origin (Vercel domain for CORS)
FRONTEND_URL="https://your-cropclimate-ai.vercel.app"

# Weather API (Open-Meteo - Free & Open)
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"
